# ==========================================
# CareNest – Environment Configuration Guide
# ==========================================

# 1. APPLICATION & SERVER RUNTIME
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# 2. DATABASE (PostgreSQL 16)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://carenest_user:carenest_password@localhost:5432/carenest_db?schema=public
DATABASE_DIRECT_URL=postgresql://carenest_user:carenest_password@localhost:5432/carenest_db?schema=public

# 3. REDIS & BULLMQ (Background Queues, Caching, Redlock)
REDIS_URL=redis://default:redis_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# 4. AUTHENTICATION & SECURITY
# Generate with: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_signing_key_care_nest_production_32_bytes_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_care_nest_production_32_bytes_min
JWT_REFRESH_EXPIRES_IN=7d
TABLET_KIOSK_PIN_SALT=salt_for_elderly_pin_hashing

# 5. FIELD-LEVEL DATA ENCRYPTION (AES-256-GCM for sensitive PHI)
# Generate with: openssl rand -hex 32
PHI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 6. TELEPHONY PROVIDER (Twilio Voice & SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_VOICE_WEBHOOK_URL=https://api.carenest.org/api/v1/telephony/voice/remind
TWILIO_STATUS_CALLBACK_URL=https://api.carenest.org/api/v1/telephony/voice/status

# 7. TRANSACTIONAL EMAIL PROVIDER (Resend / SendGrid)
RESEND_API_KEY=re_123456789abcdef
EMAIL_FROM_ADDRESS=CareNest Health <notifications@carenest.org>
EMAIL_SUPPORT_ADDRESS=support@carenest.org

# 8. AI & VOICE ASSISTANT (Google Gemini API)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 9. CLOUD OBJECT STORAGE (AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_BUCKET=carenest-health-records-storage
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key

# 10. OBSERVABILITY & ERROR TRACKING
SENTRY_DSN=https://your_sentry_key@sentry.io/project_id
LOG_LEVEL=info
